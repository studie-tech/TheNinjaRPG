{
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.fixAll.oxc": "explicit"
	},
	"biome.lsp.bin": "./app/node_modules/@biomejs/cli-darwin-arm64/biome",
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"typescript.tsserver.maxTsServerMemory": 4048,
	"typescript.experimental.useTsgo": true,
	"oxc.enable.oxlint": true,
	"oxc.enable.oxfmt": false,
	"oxc.path.oxlint": "${workspaceFolder}/app/node_modules/.bin/oxlint",
	"oxc.path.tsgolint": "${workspaceFolder}/app/node_modules/.bin/tsgolint",
	"oxc.typeAware": true,
	"chatgpt.openOnStartup": true
}
