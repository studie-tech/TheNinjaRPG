{
  "$schema": "./app/node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/target/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn"
  }
}
