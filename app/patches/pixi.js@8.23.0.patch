diff --git a/lib/rendering/renderers/gl/texture/GlTextureSystem.js b/lib/rendering/renderers/gl/texture/GlTextureSystem.js
--- a/lib/rendering/renderers/gl/texture/GlTextureSystem.js
+++ b/lib/rendering/renderers/gl/texture/GlTextureSystem.js
@@ -81,6 +81,8 @@
     this.bind(source);
   }
   bind(texture, location = 0) {
+    // A retained batch can still list a source destroyed after its last sprite moved on; nothing samples that slot.
+    if (texture?.source?.destroyed) texture = Texture.Texture.EMPTY;
     const source = texture.source;
     if (texture) {
       this.bindSource(source, location);
@@ -206,6 +208,8 @@
     this.updateStyle(source, false);
   }
   updateStyle(source, firstCreation) {
+    // Only a destroyed source lacks a style, and nothing samples it.
+    if (!source.style) return;
     const gl = this._gl;
     const glTexture = this.getGlSource(source);
     gl.bindTexture(glTexture.target, glTexture.texture);
@@ -397,6 +401,8 @@
     return this._glSamplers[sampler._resourceId] || this._initSampler(sampler);
   }
   getGlSource(source) {
+    // A destroyed source has dropped its GPU data and style; re-creating it would read the null style.
+    if (source.destroyed && !source._gpuData[this._renderer.uid] && source !== Texture.Texture.EMPTY.source) source = Texture.Texture.EMPTY.source;
     source._gcLastUsed = this._renderer.gc.now;
     return source._gpuData[this._renderer.uid] || this._initSource(source);
   }
