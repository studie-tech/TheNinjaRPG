@@ -206,6 +208,8 @@ const _GlTextureSystem = class _GlTextureSystem {
     this.updateStyle(source, false);
   }
   updateStyle(source, firstCreation) {
+    // Only a destroyed source lacks a style, and nothing samples it.
+    if (!source.style) return;
     const gl = this._gl;
     const glTexture = this.getGlSource(source);
     gl.bindTexture(glTexture.target, glTexture.texture);
