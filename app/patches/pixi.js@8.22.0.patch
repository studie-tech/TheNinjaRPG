@@ -81,6 +81,8 @@ const _GlTextureSystem = class _GlTextureSystem {
     this.bind(source);
   }
   bind(texture, location = 0) {
+    // A retained batch can still list a source destroyed after its last sprite moved on; nothing samples that slot.
+    if (texture?.source?.destroyed) texture = Texture.Texture.EMPTY;
     const source = texture.source;
