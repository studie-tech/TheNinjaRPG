{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": false,
    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    /* Extra settings */
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": false,
    /* Path aliases */
    "paths": {
      "@/env/*": ["./src/env/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/layout/*": ["./src/layout/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/validators/*": ["./src/validators/*"],
      "@/libs/*": ["./src/libs/*"],
      "@/queries/*": ["./src/queries/*"],
      "@/deltas/*": ["./src/deltas/*"],
      "@/drizzle/*": ["./drizzle/*"],
      "@/server/*": ["./src/server/*"],
      "@/api/*": ["./src/server/api/*"],
      "@/app/*": ["./src/app/*"],
      "@/data/*": ["./src/data/*"],
      "@/routers/*": ["./src/server/api/routers/*"],
      "@/components/*": ["./src/components/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/app/.well-known/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
