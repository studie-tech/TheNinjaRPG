{
  "name": "tnr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "build": "next build --debug",
    "check": "biome check . && tsc --noEmit",
    "build-stats": "ANALYZE=true next build",
    "dev": "next dev",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "bun test",
    "seed": "bun run drizzle/seed.ts",
    "discord:register-metadata": "bun run scripts/discord-register-metadata.ts",
    "dbpush": "drizzle-kit push",
    "makemigrations": "drizzle-kit generate",
    "emptymigration": "drizzle-kit generate --custom",
    "migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "postinstall": "bun run scripts/ensure-map-data.ts",
    "prepare": "cd .. && husky",
    "bundle:report": "node node_modules/nextjs-bundle-analysis/report.js",
    "bundle:compare": "node node_modules/nextjs-bundle-analysis/compare.js"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
