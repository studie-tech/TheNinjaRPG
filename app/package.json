{
  "name": "tnr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "build": "next build --debug",
    "check": "biome check . && tsc --noEmit",
    "build-stats": "next build --analyze",
    "dev": "next dev",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "bun run scripts/test-shards.ts",
    "test:serial": "bun test",
    "seed": "bun run drizzle/seed.ts",
    "discord:register-metadata": "bun run scripts/discord-register-metadata.ts",
    "dbpush": "drizzle-kit push",
    "makemigrations": "drizzle-kit generate",
    "emptymigration": "drizzle-kit generate --custom",
    "migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky",
    "bundle:report": "node node_modules/nextjs-bundle-analysis/report.js",
    "bundle:compare": "node node_modules/nextjs-bundle-analysis/compare.js"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx,mjs}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "{drizzle/**/*.ts,drizzle.config.ts}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/react": "^4.0.177",
    "@clerk/backend": "^3.29.0",
    "@clerk/mcp-tools": "^0.9.0",
    "@clerk/nextjs": "^7.10.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^7.0.6",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@modelcontextprotocol/server": "^2.4.0",
