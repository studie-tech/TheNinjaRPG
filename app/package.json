    "simplex-noise": "4.0.3",
    "sonner": "^2.0.8",
    "spacetimedb": "2.15.0",
    "sql-escaper": "^1.6.0",
    "stripe": "^23.1.0",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "text-to-svg": "^3.1.5",
    "uploadthing": "7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@babel/types": "8.1.2",
    "@biomejs/biome": "^2.6.7",
    "@radix-ui/react-use-size": "1.1.5",
    "@sentry/browser": "11.12.0",
    "@sentry/core": "11.12.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsparticles/engine": "^4.6.0",
    "@types/bun": "1.4.4",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-cytoscapejs": "^1.2.6",
    "@types/react-dom": "19.3.0",
    "@types/react-html-parser": "2.0.7",
    "@types/sanitize-html": "2.16.2",
    "@types/text-to-svg": "^3.1.4",
    "dotenv": "^18.0.10",
    "drizzle-kit": "0.31.11",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.0",
    "mysql2": "^3.24.6",
    "nextjs-bundle-analysis": "0.5.0",
    "npm-check-updates": "23.1.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 0,
    "showDetails": true,
    "skipCommentIfEmpty": true
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/react-cytoscapejs": {
      "cytoscape": "$cytoscape"
    }
  },
  "patchedDependencies": {
    "pixi.js@8.23.0": "patches/pixi.js@8.23.0.patch"
  }
}
