    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.173",
    "alea": "1.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "botid": "^1.5.13",
    "change-case": "^5.4.4",
    "chart.js": "^4.6.1",
    "chartjs-chart-wordcloud": "^4.4.5",
