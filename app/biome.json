{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "root": false,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "tests/**/*.ts",
      "tests/**/*.tsx",
      "tests/**/*.mjs",
      "drizzle/**/*.ts",
      "!drizzle/migrations/**",
      "drizzle.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@capacitor/**"
                ],
                "message": "Capacitor packages are installed in mobile/, where cap sync needs them. Call the shell through @/libs/native instead."
              },
              {
                "group": [
                  "**/libs/native/bridge"
                ],
                "message": "The raw bridge is internal to @/libs/native. Import the feature module (haptics, push, ...) instead."
              },
              {
                "group": [
                  "next/link"
                ],
                "message": "Import Link from @/layout/Link, which keeps viewport prefetch off, warms routes on intent and reports navigation pending state."
              }
            ],
            "paths": {
              "next/navigation": {
                "importNames": [
                  "usePathname"
                ],
                "message": "Read the path through usePublicPathname from @/utils/routing: a prerendered page renders under its shell variant's internal path, and usePathname would give the server and the client different values."
              }
            }
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useTailwindSortedClasses": {
          "level": "warn"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/libs/native/**",
        "src/layout/Link.tsx",
        "src/utils/routing.ts",
        "tests/libs/native/**",
        "tests/layout/navigation.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/**"
      ],
      "linter": {
        "rules": {
          "a11y": "off",
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noThenProperty": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/server/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    }
  ],
  "tailwind": {
    "mergeFunctions": [
      "clsx",
      "cn"
    ],
    "variantFunctions": [
      "cva"
    ]
  }
}
