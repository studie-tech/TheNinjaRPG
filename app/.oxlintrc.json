{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "public/**",
    "src/libs/spacetimedb/bindings/**"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@capacitor/**"
            ],
            "message": "Capacitor packages are installed in mobile/, where cap sync needs them. Call the shell through @/libs/native instead."
          },
          {
            "group": [
              "**/libs/native/bridge"
            ],
            "message": "The raw bridge is internal to @/libs/native. Import the feature module (haptics, push, ...) instead."
          },
          {
            "group": [
              "next/link"
            ],
            "message": "Import Link from @/layout/Link, which turns prefetching off: a prefetched shell buys a navigation nothing, since the data it waits on arrives through tRPC, and the game frame keeps twenty or more links in view."
          }
        ],
        "paths": [
          {
            "name": "next/navigation",
            "importNames": [
              "usePathname"
            ],
            "message": "Read the path through usePublicPathname from @/utils/routing: a prerendered page renders under its shell variant's internal path, and usePathname would give the server and the client different values."
          }
        ]
      }
    ],
    "no-unused-vars": "warn",
    "typescript/consistent-type-imports": "warn",
    "react/exhaustive-deps": "off",
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": false
      }
    ],
    "react/rules-of-hooks": "error",
    "typescript/await-thenable": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-misused-spread": "off",
    "typescript/unbound-method": "off",
    "typescript/require-array-sort-compare": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "react/static-components": "off",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-await-in-promise-methods": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-single-promise-in-promise-methods": "warn",
    "unicorn/no-new-array": "warn",
    "unicorn/no-useless-length-check": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/control-has-associated-label": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "import/namespace": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/libs/native/**",
        "src/layout/Link.tsx",
        "src/utils/routing.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "tests/**",
        "src/**/__tests__/**"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-unsafe-optional-chaining": "warn",
        "no-useless-escape": "warn",
        "nextjs/no-img-element": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/alt-text": "off",
        "oxc/erasing-op": "off",
        "unicorn/no-thenable": "off"
      }
    }
  ]
}
