# Values come from mobile/.env so nothing account-specific is committed.
app_identifier ENV.fetch("TNR_APP_ID", "com.theninjarpg.app")
apple_id ENV["APPLE_ID"]
team_id ENV["APPLE_TEAM_ID"]

