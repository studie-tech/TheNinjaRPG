# Copy to .env and fill in before building. Nothing here is a secret that ships in the
# binary — the signing material lives in your keychain and in CI, not in this file.

# Reverse-DNS bundle identifier. Must match the App ID in the Apple Developer portal and
# the applicationId in the Play Console.
TNR_APP_ID=com.theninjarpg.app

# Origin the shell navigates to once connectivity is confirmed. Point at a staging
# deployment to test against it; `bun run sync` bakes this into the bundled entry point.
TNR_ORIGIN=https://www.theninja-rpg.com

# Apple, for Fastlane uploads.
APPLE_TEAM_ID=
APPLE_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Android signing and Play uploads.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
# Path to the Play Console service-account key. Keep it outside the repo, or name it
# play-service-account.json, which is gitignored.
PLAY_SERVICE_ACCOUNT_JSON=

# Firebase is not configured through this file. Download google-services.json from the
# Firebase console and put it at android/app/google-services.json, which build.gradle
# applies the plugin from when it is present and warns about when it is not — so a missing
# file builds an app whose push notifications silently never arrive. It is gitignored
# because it is environment-specific. iOS has no Firebase SDK — it talks to APNs directly
# — so there is no GoogleService-Info.plist.

# Accounts whose sandbox purchases still grant, comma separated. Set this to the App Review
# demo account before submitting -- TestFlight and review always transact in the sandbox --
# and clear it afterwards. This belongs on the web deployment, not the shell.
# STORE_SANDBOX_USER_IDS=
