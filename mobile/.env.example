# Copy to .env and fill in before building. Nothing here is a secret that ships in the
# binary — the signing material lives in your keychain and in CI, not in this file.

# Reverse-DNS bundle identifier. Must match the App ID in the Apple Developer portal and
# the applicationId in the Play Console.
TNR_APP_ID=com.theninjarpg.app

# Origin the shell navigates to once connectivity is confirmed. Point at a staging
# deployment to test against it; `bun run sync` bakes this into the bundled entry point.
TNR_ORIGIN=https://www.theninja-rpg.com

# Apple, for Fastlane uploads.
APPLE_TEAM_ID=
APPLE_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Android signing and Play uploads.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
PLAY_SERVICE_ACCOUNT_JSON=

# The Firebase config file `cap sync` copies into the Android project. iOS has no Firebase
# SDK — it talks to APNs directly — so there is no GoogleService-Info.plist.
GOOGLE_SERVICES_JSON_PATH=
