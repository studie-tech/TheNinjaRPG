node_modules/
.env

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
build/
Gemfile.lock

# Build output. The projects themselves are committed: they carry entitlements,
# Info.plist, the manifest and Gradle config, which are part of the app rather than
# artefacts of building it.
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App/public/
ios/DerivedData/
ios/**/xcuserdata/
ios/capacitor-cordova-ios-plugins/
android/app/build/
android/build/
android/.gradle/
android/app/src/main/assets/public/
android/local.properties

# Generated by `cap sync` from capacitor.config.ts on every build.
ios/App/App/capacitor.config.json
ios/App/App/config.xml
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Firebase config carries project identifiers and is environment-specific.
android/app/google-services.json

# Signing material must never enter the repository. The Play service account is a JSON
# key, so it is named rather than covered by an extension.
play-service-account*.json
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
