{
  "name": "tnr-dev-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TheNinja-RPG desktop dev client: run local AI coding agents against game dev jobs and earn in-game rewards.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "sidecar:build": "bun build --compile sidecar/main.ts --outfile bin/tnr-dev-client --minify",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tauri-apps/cli": "^2.1.0",
    "@types/bun": "^1.3.13",
    "@types/node": "25.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0"
  }
}
